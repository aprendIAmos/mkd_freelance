# ============================================================
#  COPIÁ este archivo como ".env" y completá los valores.
#  NUNCA subas el archivo .env real a git ni a un hosting.
# ============================================================

# Puerto donde corre el servidor
PORT=3000

# -------------------------------------------------------
#  SUPABASE  →  Panel: Project Settings → API
# -------------------------------------------------------
# URL del proyecto (empieza con https:// y termina en .supabase.co)
SUPABASE_URL=

# Service Role Key — SOLO en el servidor, nunca en el navegador.
# La encontrás en Project Settings → API → Service Role (reveal).
SUPABASE_SERVICE_ROLE=

# -------------------------------------------------------
#  OPENAI  →  https://platform.openai.com/api-keys
# -------------------------------------------------------
OPENAI_API_KEY=

# Modelo a utilizar
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------
#  OPCIONAL
# -------------------------------------------------------
# Límite de consultas por minuto y por IP en /api
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=20